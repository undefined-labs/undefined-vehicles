{
  "name": "@open-core/vehicles",
  "version": "0.0.1",
  "description": "Owned-vehicles persistence domain library for OpenCore runtime",
  "license": "MPL-2.0",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js",
      "require": "./dist/server/index.js"
    },
    "./shared": {
      "types": "./dist/shared/index.d.ts",
      "import": "./dist/shared/index.js",
      "require": "./dist/shared/index.js"
    },
    "./shared/testing": {
      "types": "./dist/shared/testing/store-conformance.d.ts",
      "import": "./dist/shared/testing/store-conformance.js",
      "require": "./dist/shared/testing/store-conformance.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@open-core/framework": "*",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0",
    "vitest": "^4.0.16"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@citizenfx/server": "2.0.22443-1",
    "@open-core/framework": "^1.1.0",
    "@types/node": "^24.5.2",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  },
  "packageManager": "pnpm@10.28.0"
}
